# Copy to .env for local runs, or paste these as Environment Variables on your host.
# NEVER commit the real .env (it is already in .gitignore).

# --- Supabase Postgres connection string ---
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Session pooler" URI for a long-running web service.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Session signing key for login cookies ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=replace-with-a-long-random-string

# --- Google OAuth (login) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized redirect URIs must include: https://<your-domain>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Cloud Vision (OCR) service account ---
# Paste the ENTIRE service-account JSON as a single line.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}

# --- Google Gemini (AI summaries) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- App config ---
# Email that gets the admin dashboard.
ADMIN_EMAIL=rpsarma9247@gmail.com
# Send the login cookie over HTTPS only. Set to false for plain-HTTP local dev.
COOKIE_HTTPS_ONLY=true
